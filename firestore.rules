rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validDistrict(district) {
      return district in ['Bagalkot','Ballari','Belagavi','Bengaluru Rural','Bengaluru Urban','Bidar','Chamarajanagar','Chikkaballapur','Chikkamagaluru','Chitradurga','Dakshina Kannada','Davanagere','Dharwad','Gadag','Hassan','Haveri','Kalaburagi','Kodagu','Kolar','Koppal','Mandya','Mysuru','Raichur','Ramanagara','Bengaluru South','Shivamogga','Tumakuru','Udupi','Uttara Kannada','Vijayapura','Vijayanagara','Yadgir'];
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid','name','email','district','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && validDistrict(request.resource.data.district)
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['district'])
        && validDistrict(request.resource.data.district);
      allow delete: if owner(uid);
    }
    match /price_reports/{id} {
      function valid() {
        return request.resource.data.keys().hasOnly(['reportId','uid','mandiId','commodityId','reportedPrice','observationDate','notes','photoPath','status','dataSource','createdAt','updatedAt'])
          && request.resource.data.reportId == id
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.mandiId is string && request.resource.data.mandiId.size()>0
          && request.resource.data.commodityId is string && request.resource.data.commodityId.size()>0
          && request.resource.data.reportedPrice is number && request.resource.data.reportedPrice>0
          && request.resource.data.observationDate is string && request.resource.data.observationDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.notes is string && request.resource.data.notes.size()<=1000
          && (request.resource.data.photoPath == null || request.resource.data.photoPath == 'report_photos/' + request.auth.uid + '/' + id + '.jpg')
          && request.resource.data.status == 'UNVERIFIED'
          && request.resource.data.dataSource in ['fixture','real']
          && request.resource.data.createdAt is timestamp && request.resource.data.createdAt <= request.time
          && request.resource.data.updatedAt == request.time;
      }
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && valid();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && valid()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

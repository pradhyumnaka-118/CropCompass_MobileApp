<resources>
    <style name="Theme.CropCompass.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8FAF8</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_crop_compass</item>
        <item name="postSplashScreenTheme">@style/Theme.CropCompass</item>
    </style>
    <style name="Theme.CropCompass" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F8FAF8</item>
        <item name="android:navigationBarColor">#F8FAF8</item>
        <item name="android:windowBackground">#F8FAF8</item>
    </style>
</resources>
